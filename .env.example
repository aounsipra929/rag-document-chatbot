# ---------- OpenAI (used by the backend only, never sent to the browser) ----------
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Leave unset for models that only accept the default temperature.
# OPENAI_TEMPERATURE=0

# ---------- Retrieval ----------
# Cosine similarity (0-1). Chunks scoring below this are never sent to the model.
RELEVANCE_THRESHOLD=0.35
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------- Security ----------
APP_ENV=development
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=10
MAX_DOCS_PER_USER=20

# ---------- Database ----------
# Default is SQLite at backend/data/app.db. For PostgreSQL install psycopg and use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/docqa

# ---------- First admin account (created on first start if the email doesn't exist) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
