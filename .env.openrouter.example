# ===== Ready-made settings for a FREE OpenRouter key =====
# 1) Copy this file to  .env   2) Replace the 4 things marked CHANGE-ME   3) Save.

# --- AI provider: OpenRouter ---
OPENAI_API_KEY=CHANGE-ME-paste-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=openrouter/free
OPENAI_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
USE_JSON_MODE=false

# --- Search settings (tuned for the small free embedding model) ---
RELEVANCE_THRESHOLD=0.35
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Security ---
APP_ENV=development
JWT_SECRET=CHANGE-ME-paste-a-long-random-text-here
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=10
MAX_DOCS_PER_USER=20

# --- Your admin login (created the first time the backend starts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-min-8-characters-with-a-number
ADMIN_NAME=Administrator
